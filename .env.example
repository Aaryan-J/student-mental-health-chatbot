# Example environment file for the Student Mental Health Support Chatbot.
#
# The chatbot runs fully offline and needs NO API key. This file only holds
# optional, personal settings. run.py copies this file to ".env" on first run.
#
# Copy this file to ".env" (run.py does it for you) and edit as you like.

# Name shown by the chatbot in the console. Optional.
BOT_NAME=School Support Bot
